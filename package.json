{
  "name": "bddr-tong-viewer",
  "version": "1.0.0",
  "description": "BDDR Tong - KML Map Viewer with Google Earth UI",
  "main": "index.html",
  "scripts": {
    "serve": "node server.js",
    "start": "node server.js",
    "convert:kmz": "node tools/data/convert-kmz-to-geojson.js",
    "convert:dxf-labels": "node tools/data/convert-dxf-labels-to-geojson.js",
    "convert:pmtiles": "powershell -ExecutionPolicy Bypass -File tools/data/convert-geojson-to-pmtiles.ps1",
    "convert:all": "npm run convert:kmz && npm run convert:dxf-labels && npm run convert:pmtiles",
    "convert:team": "powershell -ExecutionPolicy Bypass -File tools/data/build-team.ps1",
    "convert:teams": "powershell -ExecutionPolicy Bypass -File tools/data/build-all-teams.ps1",
    "r2:upload-data": "powershell -ExecutionPolicy Bypass -File tools/data/upload-data-to-r2.ps1",
    "start:legacy": "http-server -p 8000",
    "deploy:worker": "wrangler deploy --config worker/wrangler.toml",
    "d1:schema": "wrangler d1 execute bddr_logs --file worker/schema.sql --remote"
  },
  "keywords": [
    "kml",
    "map",
    "leaflet",
    "google-earth",
    "geospatial",
    "satellite"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "http-server": "^14.1.0",
    "wrangler": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/username/bddr-tong-viewer.git"
  }
}
